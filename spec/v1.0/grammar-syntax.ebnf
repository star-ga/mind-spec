This grammar corresponds to the normative syntax rules in language.md.
Core v1 focuses on the tensor-oriented subset described in that chapter.

Status marks. A comment that starts with "NOT IN CORE v1" marks a form
that is written here for a later edition of the language; the mark names the
part that it covers. Read as Core v1, this grammar has every marked part
removed. The form is not part of Core v1: a conforming implementation
refuses it or documents it as an extension. The file core-v1-forms.md lists the
status of each form.
*)

(* Module structure *)
Module = { ModuleItem } ;

ModuleItem = FunctionDeclaration
           | TypeDeclaration
           | StructDeclaration
           | TraitDeclaration          (* NOT IN CORE v1 *)
           | ImportDeclaration
           | ExportDeclaration
           ;

(* Function declarations *)
FunctionDeclaration = "fn" , Identifier , "(" , [ ParameterList ] , ")" , [ "->" , Type ] , Block ;

ParameterList = Parameter , { "," , Parameter } , [ "," ] ;
Parameter = Identifier , ":" , Type ;

(* Type declarations *)
(* NOT IN CORE v1: the [ TypeParameters ] part of TypeDeclaration,      *)
(* StructDeclaration, TraitDeclaration and EnumDeclaration, with        *)
(* TypeParameters, TypeParameter, TraitBounds and TraitBound below.     *)
TypeDeclaration = "type" , Identifier , [ TypeParameters ] , "=" , Type , ";" ;

TypeParameters = "<" , TypeParameter , { "," , TypeParameter } , [ "," ] , ">" ;
TypeParameter = Identifier , [ ":" , TraitBounds ] ;

TraitBounds = TraitBound , { "+" , TraitBound } ;
TraitBound = Identifier ;

(* Struct declarations *)
StructDeclaration = "struct" , Identifier , [ TypeParameters ] , "{" , [ FieldList ] , "}" ;

FieldList = Field , { "," , Field } , [ "," ] ;
Field = Identifier , ":" , Type ;

(* Trait declarations *)
(* NOT IN CORE v1: TraitDeclaration, TraitItem and FunctionSignature.   *)
TraitDeclaration = "trait" , Identifier , [ TypeParameters ] , [ ":" , TraitBounds ] , "{" , { TraitItem } , "}" ;

TraitItem = FunctionSignature ;
FunctionSignature = "fn" , Identifier , "(" , [ ParameterList ] , ")" , [ "->" , Type ] , ";" ;

(* Import/Export *)
ImportDeclaration = "import" , ImportPath , ";" ;
ExportDeclaration = "export" , Identifier , ";" ;
(* Normative correction targeted for specification 1.7.0, decided  *)
(* by the specification owner on 2026-10-07: path segments are      *)
(* separated by ".". Earlier text of this grammar                   *)
(* wrote "::", which no released reference compiler accepted for    *)
(* `import`; the reference `use` additionally accepts "::" as an    *)
(* extension. Qualifier semantics: language.md, "Module-qualified   *)
(* references".                                                     *)
ImportPath = Identifier , { "." , Identifier } ;

(* Types *)
Type = PrimitiveType
     | TensorType
     | TupleType
     | ArrayType
     | FunctionType            (* NOT IN CORE v1 *)
     | DifferentiableType
     | TraitObjectType         (* NOT IN CORE v1 *)
     | IdentifierType
     ;

PrimitiveType = "i32" | "i64" | "f32" | "f64" | "bool" | "unit" ;

TensorType = "Tensor" , "<" , DType , "," , Shape , ">" ;
DType = "i32" | "i64" | "f32" | "f64" ;
Shape = "[" , [ DimensionList ] , "]" ;
DimensionList = Dimension , { "," , Dimension } , [ "," ] ;
Dimension = IntegerLiteral | Identifier ;

TupleType = "(" , [ TypeList ] , ")" ;
TypeList = Type , { "," , Type } , [ "," ] ;

ArrayType = "[" , Type , ";" , IntegerLiteral , "]" ;

(* NOT IN CORE v1: FunctionType. *)
FunctionType = "(" , [ TypeList ] , ")" , "->" , Type ;

DifferentiableType = "diff" , Type ;

(* NOT IN CORE v1: TraitObjectType. *)
TraitObjectType = "dyn" , Identifier ;

(* In Core v1 the type arguments belong to the built-in generic types   *)
(* Option and Result. A user-declared type has no type parameters in    *)
(* Core v1.                                                             *)
(* NOT IN CORE v1: the [ "<" , TypeList , ">" ] part of IdentifierType  *)
(* when the identifier names a user-declared type. The token ">>" that  *)
(* ends two nested type argument lists closes both lists.               *)
IdentifierType = Identifier , [ "<" , TypeList , ">" ] ;

(* Statements and blocks *)
Block = "{" , { Statement } , [ Expression ] , "}" ;

Statement = LetStatement
          | ExpressionStatement
          | ReturnStatement
          | DeferStatement
          | LoopExitStatement
          ;

LetStatement = "let" , Pattern , [ ":" , Type ] , "=" , Expression , ";" ;

Pattern = IdentifierPattern
        | TuplePattern
        | WildcardPattern
        ;

IdentifierPattern = Identifier ;
TuplePattern = "(" , [ PatternList ] , ")" ;
PatternList = Pattern , { "," , Pattern } , [ "," ] ;
WildcardPattern = "_" ;

ExpressionStatement = Expression , ";" ;

ReturnStatement = "return" , [ Expression ] , ";" ;

DeferStatement = "defer" , Block ;

(* A loop exit is valid inside the body of a WhileExpression or a     *)
(* ForExpression. It ends the innermost loop (break) or starts its    *)
(* next iteration (continue). It takes no value and no label. The     *)
(* semicolon is optional. The words are not reserved: they are names  *)
(* in every position except the first token of an item of a Block.    *)
(* An item of a Block that starts with the word `break` or            *)
(* `continue` is a LoopExitStatement: it ends after the word and the  *)
(* optional semicolon, and what follows starts the next statement.    *)
(* `break - 1;` is the statement `break` and then the statement       *)
(* `- 1;`, and `break = 5;` is not a statement. No ExpressionStatement *)
(* starts with these two words, and the final Expression of a Block   *)
(* is never one of them.                                              *)
LoopExitStatement = ( "break" | "continue" ) , [ ";" ] ;

(* Expressions *)
Expression = AssignmentExpression ;

AssignmentExpression = LogicalOrExpression , [ AssignmentOperator , AssignmentExpression ] ;
AssignmentOperator = "=" | "+=" | "-=" | "*=" | "/=" | ":=" ;

LogicalOrExpression = LogicalAndExpression , { "||" , LogicalAndExpression } ;

LogicalAndExpression = ComparisonExpression , { "&&" , ComparisonExpression } ;

ComparisonExpression = AdditiveExpression , { ComparisonOperator , AdditiveExpression } ;
ComparisonOperator = "==" | "!=" | "<" | ">" | "<=" | ">=" ;

AdditiveExpression = MultiplicativeExpression , { AdditiveOperator , MultiplicativeExpression } ;
AdditiveOperator = "+" | "-" ;

MultiplicativeExpression = UnaryExpression , { MultiplicativeOperator , UnaryExpression } ;
MultiplicativeOperator = "*" | "/" | "%" ;

UnaryExpression = [ UnaryOperator ] , PostfixExpression ;
UnaryOperator = "-" | "!" ;

PostfixExpression = PrimaryExpression , { PostfixOperator } ;

PostfixOperator = CallOperator
                | IndexOperator
                | FieldAccessOperator
                | MethodCallOperator
                ;

CallOperator = "(" , [ ArgumentList ] , ")" ;
ArgumentList = Expression , { "," , Expression } , [ "," ] ;

IndexOperator = "[" , IndexExpression , "]" ;
IndexExpression = Expression
                | SliceExpression
                ;

SliceExpression = [ Expression ] , ":" , [ Expression ] , [ ":" , [ Expression ] ] ;

FieldAccessOperator = "." , Identifier ;

MethodCallOperator = "." , Identifier , "(" , [ ArgumentList ] , ")" ;

(* Primary expressions *)
PrimaryExpression = Literal
                  | Identifier
                  | ParenthesizedExpression
                  | TupleExpression
                  | ArrayExpression
                  | TensorConstructor
                  | BlockExpression
                  | IfExpression
                  | MatchExpression
                  | WhileExpression
                  | ForExpression
                  | FunctionExpression      (* NOT IN CORE v1 *)
                  ;

ParenthesizedExpression = "(" , Expression , ")" ;

TupleExpression = "(" , Expression , "," , [ ExpressionList ] , ")" ;
ExpressionList = Expression , { "," , Expression } , [ "," ] ;

ArrayExpression = "[" , [ ArrayElements ] , "]" ;
ArrayElements = Expression , { "," , Expression } , [ "," ] ;

TensorConstructor = "tensor" , "(" , Expression , [ "," , "dtype" , ":" , DType ] , ")" ;

BlockExpression = Block ;

IfExpression = "if" , Expression , Block , [ "else" , ( IfExpression | Block ) ] ;

MatchExpression = "match" , Expression , "{" , { MatchArm } , "}" ;
MatchArm = Pattern , "=>" , ( Expression , "," | Block ) ;

WhileExpression = "while" , Expression , Block ;

(* The expression after "in" is an ordinary Expression. This grammar has *)
(* no range expression: `for i in a..b` is not defined here; a range is  *)
(* an extension.                                                          *)
ForExpression = "for" , Pattern , "in" , Expression , Block ;

(* NOT IN CORE v1: FunctionExpression (closures, function values).     *)
FunctionExpression = "fn" , "(" , [ ParameterList ] , ")" , [ "->" , Type ] , Block ;

(* Tensor operations (Core v1 intrinsics) *)
(* These are typically called as functions: sum(x, axes, keepdims) *)
(* The function call syntax is covered by CallOperator above *)

(* ============================================================ *)
(* v1.1 candidate additions (Phase 10.5 — Systems Programming   *)
(* Foundation). Implemented in mindc 0.2.5+. Status: evolving — *)
(* implementations claiming v1.0 conformance MAY parse these,   *)
(* implementations claiming v1.1 MUST.                          *)
(* ============================================================ *)

(* Compile-time constant declaration.                           *)
ConstDeclaration = "const" , Identifier , [ ":" , Type ] , "=" , Expression , [ ";" ] ;

(* Algebraic enums.                                                  *)
(* NOT IN CORE v1: the [ TypeParameters ] part of EnumDeclaration.   *)
EnumDeclaration = "enum" , Identifier , [ TypeParameters ] , "{" , [ EnumVariantList ] , "}" ;
EnumVariantList = EnumVariant , { "," , EnumVariant } , [ "," ] ;
EnumVariant     = Identifier , [ "(" , [ EnumPayloadList ] , ")" ] ;
EnumPayloadList = Type , { "," , Type } ;

(* Module block (compile-time grouping).                        *)
ModuleBlock     = "module" , Identifier , "{" , { ModuleItem } , "}" ;

(* Use-clause (lightweight import).                             *)
UseDeclaration  = "use" , ImportPath , [ ";" ] ;

(* Attribute on items (`#[name]`, `#[name(arg, ...)]`). The spelling *)
(* starts with "#". The form `[name]` without the "#" is not an      *)
(* attribute. An argument is an identifier, a literal, or a name     *)
(* bound to a literal (`#[requires(mind_spec = "1.2")]`).            *)
Attribute       = "#" , "[" , Identifier , [ "(" , [ AttributeArgList ] , ")" ] , "]" ;
AttributeArgList = AttributeArg , { "," , AttributeArg } ;
AttributedItem  = Attribute , { Attribute } , ModuleItem ;
AttributeArg    = Identifier | Literal | Identifier , "=" , Literal ;

(* Runtime assertion (no return value).                         *)
(* Additive, targeted for specification 1.7.0. In the            *)
(* parenthesised alternative a pair whose second element is a    *)
(* string literal is the condition and the message, not a tuple. *)
(* Any other tuple written as the condition is ill-typed,        *)
(* because an assert condition is `bool` (stdlib.md, core        *)
(* module); the reference compiler rejects such a parenthesised  *)
(* tuple at parse time (487dd5c7, v0.10.3) and does not          *)
(* otherwise check the condition's type.                         *)
AssertStatement = "assert" , Expression , [ "," , StringLiteral ] , [ ";" ]
                | "assert" , "(" , Expression , "," , StringLiteral , ")" , [ ";" ]
                ;

(* Postfix cast.                                                *)
AsCast          = Expression , "as" , Type ;

(* Logical and bitwise binary operators (Phase 10.5 Tier-1).    *)
LogicalOr       = Expression , "||" , Expression ;
LogicalAnd      = Expression , "&&" , Expression ;
BitwiseOr       = Expression , "|"  , Expression ;
BitwiseAnd      = Expression , "&"  , Expression ;
BitwiseXor      = Expression , "^"  , Expression ;
ShiftLeft       = Expression , "<<" , Expression ;
ShiftRight      = Expression , ">>" , Expression ;

(* Operator precedence (highest binds tightest, all left-assoc): *)
(*   1. *  /                                                     *)
(*   2. |  &  ^  <<  >>                                          *)
(*   3. +  -                                                     *)
(*   4. as       (postfix cast)                                  *)
(*   5. == != < <= > >=                                          *)
(*   6. &&                                                       *)
(*   7. ||                                                       *)
(* Reference implementation: mindc 0.2.5+ Pratt parser           *)
(* (src/parser/mod.rs::parse_pratt).                             *)
